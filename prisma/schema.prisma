generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. Phân hệ Người dùng & Định danh (Customer Identity)
// ---------------------------------------------------------

model User {
  id           String          @id @default(cuid())
  phone        String          @unique
  email        String?         @unique
  fullName     String
  passwordHash String
  role         String          @default("CUSTOMER") // CUSTOMER | ADMIN | STAFF
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Quan hệ
  tasteProfile   TasteProfile?
  addresses      Address[]
  orders         Order[]
  loyaltyAccount LoyaltyAccount?

  @@map("users")
}

// ---------------------------------------------------------
// 2. Phân hệ "Gu Ăn Phở" (Customer Taste Profile)
// ---------------------------------------------------------

model TasteProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  favoriteDishId String?  // ID món phở ruột thường gọi
  brothType      String   @default("DAM_DA")     // THANH | DAM_DA | BEO_NGAY
  onionStyle     String   @default("NHIEU_HANH")  // IT_HANH | NHIEU_HANH | HANH_TRAN | DAU_HANH
  herbStyle      String   @default("DU_RAU")      // DU_RAU | KHONG_RAU_MUI | KHONG_HANH_TAY
  spicyLevel     Int      @default(1)             // 0: Không cay, 1: Cay vừa, 2: Cay nồng, 3: Siêu cay
  crullerPref    String   @default("QUAY_GION")   // QUAY_GION | QUAY_MEM | KHONG_QUAY
  customNote     String?  // Ví dụ: "Xin thêm 1 chén nước béo hành trần riêng"
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taste_profiles")
}

// ---------------------------------------------------------
// 3. Phân hệ Sổ địa chỉ giao hàng (Addresses)
// ---------------------------------------------------------

model Address {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  phone         String
  addressLine   String   // Số nhà, tên đường
  ward          String?  // Phường / Xã
  district      String   // Quận / Huyện
  city          String   @default("Hà Nội") // Tỉnh / TP
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ---------------------------------------------------------
// 4. Phân hệ Hội viên "Bát Phở Tri Kỷ" (Loyalty Engine)
// ---------------------------------------------------------

model LoyaltyAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalPoints      Int      @default(50) // Điểm tích lũy trọn đời (khởi tạo tặng 50 điểm chào mừng)
  availablePoints  Int      @default(50) // Điểm khả dụng để đổi quà
  membershipTier   String   @default("DONG") // DONG | BAC | VANG | KIM_CUONG
  totalSpent       Float    @default(0) // Tổng tiền đã chi (VND)
  totalOrdersCount Int      @default(0) // Số đơn hoàn thành
  updatedAt        DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String   @id @default(cuid())
  loyaltyAccountId String
  orderId          String?  // Đơn hàng phát sinh giao dịch điểm (nếu có)
  pointsChange     Int      // + Điểm cộng hoặc - Điểm trừ
  type             String   // EARN_ORDER | REDEEM_REWARD | WELCOME_BONUS | ADJUSTMENT
  balanceAfter     Int      // Số dư điểm sau biến động
  description      String   // Diễn giải (Ví dụ: "Tích điểm đơn hàng #PHO-8612")
  createdAt        DateTime @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("loyalty_transactions")
}

model LoyaltyReward {
  id             String   @id @default(cuid())
  title          String   // Tên phần thưởng: "Đĩa quẩy giòn gia truyền (3 cái)", "Trứng chần nước béo"
  description    String?
  pointsRequired Int      // Số điểm cần để đổi (ví dụ: 100 điểm)
  rewardType     String   // FREE_ITEM | DISCOUNT_PERCENT | DISCOUNT_CASH
  discountValue  Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("loyalty_rewards")
}

// ---------------------------------------------------------
// 5. Phân hệ Danh mục & Thực đơn (Menu Catalog)
// ---------------------------------------------------------

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  dishes Dish[]

  @@map("categories")
}

model Dish {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String   @unique
  price       Float    // Giá bán VND
  description String
  imageUrl    String
  isAvailable Boolean  @default(true)
  isSignature Boolean  @default(false) // Món truyền thống đặc trưng của quán 1986
  createdAt   DateTime @default(now())

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("dishes")
}

// ---------------------------------------------------------
// 6. Phân hệ Đơn hàng & Chi tiết (Orders & 1-Click Reorder)
// ---------------------------------------------------------

model Order {
  id                  String   @id @default(cuid())
  orderCode           String   @unique // Ví dụ: PHO-8612
  userId              String?  // Null nếu là Guest checkout
  guestPhone          String?  // Dành cho khách vãng lai
  guestName           String?  // Tên khách vãng lai
  status              String   @default("PENDING") // PENDING | CONFIRMED | COOKING | DELIVERING | COMPLETED | CANCELLED
  totalAmount         Float    // Tiền trước giảm giá
  discountAmount      Float    @default(0) // Số tiền giảm từ voucher / điểm
  finalAmount         Float    // Số tiền thanh toán thực tế
  paymentMethod       String   @default("COD") // COD | BANK_TRANSFER | VNPAY | MOMO
  paymentStatus       String   @default("UNPAID") // UNPAID | PAID
  deliveryAddressText String   // Snapshot địa chỉ giao hàng
  notes               String?  // Lời dặn dò thêm của khách
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("orders")
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  dishId             String?
  dishName           String  // Tên món lưu snapshot
  unitPrice          Float   // Đơn giá tại thời điểm đặt
  quantity           Int     @default(1)
  subtotal           Float   // Thành tiền
  customizedOptions  String? // JSON snapshot cấu hình bát: { brothType, onionStyle, herbStyle, spicyLevel, crullerPref }

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish? @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
