# ==============================================================================
# PHỞ GIA TRUYỀN 1986 - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Sao chép file này thành .env và cấu hình các giá trị phù hợp với môi trường của bạn.
# Tuyệt đối không commit file .env chứa thông tin bí mật thật lên Git repository.

# ------------------------------------------------------------------------------
# 1. HẠ TẦNG & CƠ SỞ DỮ LIỆU (DATABASE & SERVER)
# ------------------------------------------------------------------------------
PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pho_1986_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=1234
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=pho_gia_truyen_1986_spring_boot_jwt_secret_key_very_long_for_hmac_sha_256
PAYMENT_WEBHOOK_SECRET=pho1986_webhook_secret_key_prod_auth_2026

# ------------------------------------------------------------------------------
# 3. CỔNG THANH TOÁN SEPAY (VIETQR / NGÂN HÀNG CHUYỂN KHOẢN TỰ ĐỘNG)
# ------------------------------------------------------------------------------
# Bật/tắt cổng SePay (Mặc định: false)
SEPAY_ENABLED=false

# Môi trường gateway: sandbox | production
SEPAY_ENV=sandbox

# Mã định danh merchant SePay (Bắt buộc khi SEPAY_ENABLED=true)
MERCHANTID=your_sepay_merchant_id

# Khóa bí mật ký HMAC-SHA256 checkout payload (Bắt buộc khi SEPAY_ENABLED=true)
SEPAY_SECRETKEY=your_sepay_api_secret_key

# Khóa bí mật xác thực Webhook IPN gửi từ SePay về Backend (Bắt buộc cho Webhook)
SEPAY_IPN_SECRET=your_sepay_ipn_secret_token

# Endpoint Webhook công khai để SePay gửi thông báo IPN (Server-to-Server)
SEPAY_IPN_URL=http://localhost:8080/api/v1/payments/sepay/ipn

# URLs đón redirect từ SePay
SEPAY_SUCCESS_URL=http://localhost:8080/api/v1/payments/sepay/return/success
SEPAY_ERROR_URL=http://localhost:8080/api/v1/payments/sepay/return/error
SEPAY_CANCEL_URL=http://localhost:8080/api/v1/payments/sepay/return/cancel

# URLs frontend đón người dùng sau thanh toán SePay
SEPAY_BOOKING_FRONTEND_REDIRECT_URL=http://localhost:5173#order
SEPAY_FRONTEND_REDIRECT_URL=http://localhost:5173#order

# ------------------------------------------------------------------------------
# 4. CỔNG THANH TOÁN VÍ ĐIỆN TỬ MOMO (MOMO PAYMENT GATEWAY V2)
# ------------------------------------------------------------------------------
# Bật/tắt module MoMo (Mặc định: false)
MOMO_ENABLED=false

# Mã đối tác MoMo cung cấp (Mặc định: MOMO)
MOMO_PARTNER_CODE=MOMO

# Khóa truy cập API của MoMo (Bắt buộc khi MOMO_ENABLED=true)
MOMO_ACCESSKEY=your_momo_access_key

# Khóa bí mật ký HMAC-SHA256 cho Request & Callback IPN (Bắt buộc khi MOMO_ENABLED=true)
MOMO_SECRETKEY=your_momo_secret_key

# Endpoint API MoMo tạo thanh toán (Test: https://test-payment.momo.vn/v2/gateway/api/create, Live: https://payment.momo.vn/v2/gateway/api/create)
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# URL frontend để MoMo chuyển hướng sau khi khách thanh toán
MOMO_REDIRECT_URL=http://localhost:5173#order
MOMO_AI_COIN_REDIRECT_URL=http://localhost:5173#order

# URL public webhook HTTPS của backend để MoMo gọi server-to-server IPN (Bắt buộc https:// trên production)
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn

# Loại yêu cầu thanh toán (Mặc định: captureWallet)
MOMO_REQUEST_TYPE=captureWallet

# Ngôn ngữ hiển thị (vi | en)
MOMO_LANGUAGE=vi

# Thời gian timeout khi gọi MoMo API (Tối thiểu 30s)
MOMO_TIMEOUT=30s
